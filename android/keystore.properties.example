# Copia este archivo como keystore.properties y rellena los valores.
# NUNCA subas keystore.properties ni el .keystore/.jks a Git.

# Ruta al keystore (relativa a android/app/ donde se evalúa)
# Si el keystore está en android/: storeFile=../medicontrol.keystore
storeFile=../medicontrol.keystore
storePassword=TU_CONTRASEÑA_KEYSTORE
keyAlias=medicontrol
keyPassword=TU_CONTRASEÑA_ALIAS
